{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "InMemory": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5096",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "SqlServer": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5096",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "EventStore__UseSqlServer": "true",
        "ConnectionStrings__Shop": "Server=localhost;Database=LawnDartShop;Trusted_Connection=True;TrustServerCertificate=True"
      }
    }
  }
}
