{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "src/LawnDart/bin/Release/net10.0/LawnDart.dll",
            "src/LawnDart.EventSourcing/bin/Release/net10.0/LawnDart.EventSourcing.dll",
            "src/LawnDart.Messaging/bin/Release/net10.0/LawnDart.Messaging.dll",
            "src/LawnDart.Messaging.InMemory/bin/Release/net10.0/LawnDart.Messaging.InMemory.dll",
            "src/LawnDart.Messaging.RabbitMQ/bin/Release/net10.0/LawnDart.Messaging.RabbitMQ.dll",
            "src/LawnDart.Messaging.AzureServiceBus/bin/Release/net10.0/LawnDart.Messaging.AzureServiceBus.dll",
            "src/LawnDart.Messaging.AwsSqs/bin/Release/net10.0/LawnDart.Messaging.AwsSqs.dll",
            "src/LawnDart.Messaging.SqlServer/bin/Release/net10.0/LawnDart.Messaging.SqlServer.dll",
            "src/LawnDart.Messaging.Postgres/bin/Release/net10.0/LawnDart.Messaging.Postgres.dll",
            "src/LawnDart.Messaging.Testing/bin/Release/net10.0/LawnDart.Messaging.Testing.dll",
            "src/LawnDart.EventSourcing.SqlServer/bin/Release/net10.0/LawnDart.EventSourcing.SqlServer.dll",
            "src/LawnDart.EventSourcing.Postgres/bin/Release/net10.0/LawnDart.EventSourcing.Postgres.dll",
            "src/LawnDart.Projections.Lightweight/bin/Release/net10.0/LawnDart.Projections.Lightweight.dll",
            "src/LawnDart.Projections.Lightweight.SqlServer/bin/Release/net10.0/LawnDart.Projections.Lightweight.SqlServer.dll",
            "src/LawnDart.Projections.Lightweight.Postgres/bin/Release/net10.0/LawnDart.Projections.Lightweight.Postgres.dll",
            "src/LawnDart.AspNetCore/bin/Release/net10.0/LawnDart.AspNetCore.dll",
            "src/LawnDart.Authorization.AspNetCore/bin/Release/net10.0/LawnDart.Authorization.AspNetCore.dll",
            "src/LawnDart.Testing/bin/Release/net10.0/LawnDart.Testing.dll"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md", "api/toc.yml"]
      },
      {
        "files": [
          "index.md",
          "toc.yml",
          "docs/**.md",
          "docs/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**",
          "src/**/*.cs",
          "tests/**/*.cs",
          "demos/**/*.cs"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "LawnDart",
      "_appTitle": "LawnDart Documentation",
      "_appLogoPath": "assets/docs-logo.png",
      "_appFaviconPath": "assets/favicon-32.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/sellistixorg/LawnDart",
        "branch": "main"
      }
    },
    "template": ["default", "modern", "templates"],
    "sitemap": {
      "baseUrl": "https://sellistixorg.github.io/LawnDart"
    }
  }
}
