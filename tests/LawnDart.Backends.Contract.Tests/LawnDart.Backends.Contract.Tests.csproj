    <ProjectReference Include="..\..\src\LawnDart.Projections.Lightweight.SqlServer\LawnDart.Projections.Lightweight.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\LawnDart.Testing\LawnDart.Testing.csproj" />
    <ProjectReference Include="..\LawnDart.TestUtilities\LawnDart.TestUtilities.csproj" />
