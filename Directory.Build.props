<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Authors>Sellistix LLC</Authors>
    <Company>Sellistix LLC</Company>
    <Product>LawnDart</Product>
    <Copyright>Copyright (c) 2026 Sellistix LLC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sellistixorg/LawnDart</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sellistixorg/LawnDart</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>eventsourcing;cqrs;ddd;messaging;patterns;lawndart</PackageTags>
    <PackageIcon Condition="'$(IsPackable)' != 'false'">nuget-icon.png</PackageIcon>
    <GenerateDocumentationFile Condition="'$(IsPackable)' != 'false'">true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <PackageReleaseNotes>https://github.com/sellistixorg/LawnDart/releases</PackageReleaseNotes>
    <!-- Version comes from git tags via MinVer. Do not add <Version>. -->
    <!-- 0.7 is the line in progress. The v0.7.0-alpha.1 tag is the release. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.7</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha</MinVerDefaultPreReleaseIdentifiers>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\nuget-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
