<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Authors>Sellistix</Authors>
    <Company>Sellistix</Company>
    <Product>LawnDart</Product>
    <Copyright>Copyright (c) 2026 Sellistix</Copyright>
    <Version>0.1.0-alpha</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sellistixorg/LawnDart</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sellistixorg/LawnDart</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>eventsourcing;cqrs;ddd;messaging;patterns;lawndart</PackageTags>
    <PackageIcon Condition="'$(IsPackable)' != 'false'">nuget-icon.png</PackageIcon>
    <GenerateDocumentationFile Condition="'$(IsPackable)' != 'false'">true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\nuget-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
