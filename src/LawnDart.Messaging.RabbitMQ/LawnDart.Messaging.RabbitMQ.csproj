<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>LawnDart.Messaging.RabbitMQ</PackageId>
    <Description>RabbitMQ transport for LawnDart.Messaging. One quorum queue per subscription, bound to each handled event type. Set QueueLayout to EventType for one queue per event type. Failed deliveries wait on a retry queue, then dead-letter when that handling is on.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LawnDart.Messaging\LawnDart.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LawnDart.Messaging.RabbitMQ.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>
