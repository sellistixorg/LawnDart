<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>LawnDart.EventSourcing</PackageId>
    <Description>Event sourcing runtime and InMemory store for LawnDart.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LawnDart\LawnDart.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LawnDart.EventSourcing.Tests" />
    <InternalsVisibleTo Include="LawnDart.EventSourcing.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
