    <PackageId>LawnDart</PackageId>
    <Description>Core interfaces and abstractions for the LawnDart command–event–state runtime.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" />
